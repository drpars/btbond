# Maintainer: drpars <https://github.com/drpars>
#
# BAĞIMLILIKLARIN GERÇEK LİSTESİ BURADA, `pyproject.toml`da değil: aracın
# ihtiyaçlarının çoğu PyPI paketi değil sistem paketi, ve pip onları çözemez.
#
# `depends` yalnız HER koşuda gerekenleri taşıyor; kanala ya da alt komuta
# özel olanlar `optdepends`ta ve orada NE İÇİN gerektikleri yazılı — kurulu
# olmadıklarında araç susmuyor, eksikliği söylüyor.
#
# KOŞTURULDU (2026-09-04, bu makine): `makepkg -f` temiz bitti, `check()`
# içinde dört test paketi de geçti (65 + 28 + 53 + altın çıktı), çıktı
# `btbond-0.1.0-1-any.pkg.tar.zst` ve içinde `/usr/bin/btbond` var. Paketin
# boyu buraya YAZILMIYOR: iki ardışık derleme 10 bayt farkla çıktı, yani
# sabit değil.
#
# `source` bir sürüm ETİKETİNE bakıyor, dala değil: `pkgver`in bir şeye
# karşılık gelmesi için kaynağın değişmez olması gerekiyor — dal ilerler,
# etiket ilerlemez. Etiket yokken `makepkg` indiremiyordu (ölçüldü: depoda
# sıfır etiket), `v0.1.0` o yüzden atıldı.
#
# `sha256sums` GitHub'ın KENDİ ÜRETTİĞİ arşiv tarball'ının özeti. Bu biçimin
# bayt kararlılığı GitHub tarafından garanti edilmiyor; özet bir gün tutmazsa
# çare hash'i güncellemek değil, kaynağı etikete adresli git'e çevirmektir:
#   source=("$pkgname::git+$url.git#tag=v$pkgver")  + makedepends 'git'
# (o biçimde `sha256sums=('SKIP')` doğrudur, çünkü doğrulamayı etiket yapar).

pkgname=btbond
pkgver=0.1.0
pkgrel=1
pkgdesc="Replicate Bluetooth bonds between a Linux host and a Windows guest sharing one radio"
arch=('any')
url="https://github.com/drpars/btbond"
license=('MIT')
depends=('python' 'bluez' 'bluez-utils')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=(
  'python-textual: `btbond tui` (diff görünümü)'
  'bluez-deprecated-tools: `hcitool` — `remote-info` ve `--capture-hci`; bu çekirdek `Read Remote Version Information`ı kendiliğinden YOLLAMIYOR, yani onsuz üç sürüm alanı sessizce eksik kalır'
  'libvirt: `virsh` — domain keşfi ve `qemu-guest-agent` kanalı'
  'hivex: offline kovan kanalı (kapalı misafir, dual boot)'
  'qemu-img: `qemu-nbd` — imaj dosyasındaki misafiri bağlamak'
  'vfioctl: radyoyu devretmek (`btbond handover`)'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('3c855b39c863d1029f61a9684f5619e57d91225b1aab00d0d2f3d38a65009fd9')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  # Testler root, misafir, terminal ve kovan GEREKTİRMEZ (→ README, "Testler").
  # `test_tui.py` textual istiyor; yoksa atlanır, çünkü `python-textual`
  # `optdepends` ve `makedepends`te değil.
  for t in tests/test_emitters.py tests/test_transport.py tests/test_hcicapture.py; do
    python "$t"
  done
  python -c 'import textual' 2>/dev/null && python tests/test_tui.py || true
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
